#!/usr/bin/env bash
# Tiny CLI wrapper around the agent SSE endpoint.
# Usage:
#   ./bin/loyalty-agent "your loyalty question"
# Env:
#   LOYALTY_AGENT_HOST  default: http://localhost:8080
set -euo pipefail

HOST="${LOYALTY_AGENT_HOST:-http://localhost:8080}"
Q="${1:?usage: loyalty-agent \"your question\"}"

# url-encode via python (more portable than jq across environments)
ENC=$(python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))" "$Q")
URL="$HOST/agent/stream?q=$ENC"

# colours: bold-yellow query, cyan tool→/dim-cyan tool←, white answer, dim-green done, red error
curl -sN "$URL" | while IFS= read -r line; do
  case "$line" in
    "data:[query] "*)  printf "\033[1;33m▸ %s\033[0m\n" "${line#data:[query] }" ;;
    "data:[tool] → "*) printf "\033[36m  %s\033[0m\n"   "${line#data:[tool] }"  ;;
    "data:[tool] ← "*) printf "\033[2;36m  %s\033[0m\n" "${line#data:[tool] }"  ;;
    "data:[answer] "*) printf "  \033[37m%s\033[0m\n"   "${line#data:[answer] }" ;;
    "data:[done] "*)   printf "\033[2;32m─ %s\033[0m\n" "${line#data:[done] }"  ;;
    "data:[error] "*)  printf "\033[1;31m✗ %s\033[0m\n" "${line#data:[error] }" ;;
  esac
done
